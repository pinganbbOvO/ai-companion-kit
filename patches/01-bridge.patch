+// CARD_URL_PATCH：把 QQ 分享卡片（json 段）解析成人能读的东西
+//   QQ 卡片的 data 是一串 JSON ✗ 常见形状：
+//     { app, meta: { detail_1: { title, desc, qqdocurl, url } }, prompt }
+//     { meta: { news: { title, desc, jumpUrl } } }
+//   → "[卡片] 标题（描述）链接"
+// ══════════════════════════════════════════════════════════════
+function parseQqCard(d) {
+  const raw = String((d && (d.data ?? d.text ?? d.content)) || '');
+  if (!raw) return '[卡片消息]';
+  let j = null;
+  try { j = JSON.parse(raw); } catch {
+    const m = raw.match(/https?:\/\/[^\s"'\\]+/);
+    return m ? ('[卡片] ' + m[0]) : '[卡片消息]';
+  }
+  const meta = j.meta || {};
+  const d1 = meta.detail_1 || meta.detail || {};
+  const news = meta.news || {};
+  const title = String(d1.title || news.title || j.title || '').trim();
+  const desc = String(d1.desc || news.desc || j.desc || '').trim();
+  const url = String(d1.qqdocurl || d1.url || news.jumpUrl || news.url || j.url || '').trim();
+  const prompt = String(j.prompt || '').trim();
+  const app = String(j.app || '').trim();
+  const bits = [];
+  if (title) bits.push(title);
+  if (desc && desc !== title) bits.push('（' + desc.slice(0, 60) + '）');
+  if (url) bits.push(url);
+  if (!bits.length && prompt) bits.push(prompt.slice(0, 80));
+  if (!bits.length) {
+    const m = raw.match(/https?:\/\/[^\s"'\\]+/);
+    if (m) bits.push(m[0]);
+  }
+  if (!bits.length) return '[卡片消息' + (app ? ':' + app : '') + ']';
+  return '[卡片] ' + bits.join(' ');
+}
