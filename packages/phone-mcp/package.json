{
  "name": "phone-mcp",
  "version": "1.0.0",
  "description": "用 MCP 驱动一台安卓手机或模拟器：点按、滑动、输入中文、截图、录屏看视频、跑宏、控制网易云音乐、刷 QQ 空间",
  "type": "module",
  "main": "src/phone-mcp.js",
