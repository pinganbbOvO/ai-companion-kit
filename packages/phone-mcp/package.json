  "keywords": [
    "mcp",
    "model-context-protocol",
    "android",
    "adb",
    "automation",
    "emulator",
    "ai-agent",
    "netease-music",
    "qzone"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  }
